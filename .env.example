# For Docker, keep this file beside compose.yaml.
# Apply edits with: docker compose up -d --force-recreate
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Read the group using your Telegram account (for groups you already joined).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
# Fixed to the sole group approved for this user session.
TELEGRAM_SOURCE_CHATS=https://t.me/+RMtFLhPbWG9Hn0MQ
TELEGRAM_USER_SESSION=telegram-user

# Analysis defaults.
HISTORY_MONTHS=6
# Alert only when the drop is strictly greater than this percentage.
# Direct Python runs reload this for each new message; old messages are not replayed.
DISCOUNT_THRESHOLD_PERCENT=20

# Group-only polling. These policy flags cannot enable push updates.
TELEGRAM_DETECTION_MODE=poll
TELEGRAM_ALLOW_ACCOUNT_UPDATES=false
# Direct Python runs reload this each poll. Minimum 1 second; Telegram rate limits may add waits.
TELEGRAM_POLL_SECONDS=3
